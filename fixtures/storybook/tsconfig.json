// The Storybook fixture: stories typed with Storybook's own types, as a project that moves to Forgebook has them.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@forgebook/typescript-config/react.json",
  "compilerOptions": {
    "types": ["node", "vite/client", "@forgebook/story-format/client"],
    "allowJs": true,
    "checkJs": false,
    // the plugin's types are Forgebook's, whose modules carry `.ts` (Node loads them)
    "allowImportingTsExtensions": true
  },
  "include": ["src", "plugin", "stories.ts", ".storybook"]
}
