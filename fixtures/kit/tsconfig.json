// The fixture kit: a small package of React components with their stories, read by the extractor's and the plugin's
// tests and shown by the fixture catalogue.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@forgebook/typescript-config/react.json",
  "compilerOptions": {
    "types": ["node", "vite/client", "@forgebook/story-format/client"],
    // its preset (`forgebook.ts`) reads Forgebook's configuration types, whose modules carry `.ts` (Node loads them)
    "allowImportingTsExtensions": true
  },
  "include": ["src", "stories.ts", "forgebook.ts"]
}
