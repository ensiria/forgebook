// The Solid fixture: components and stories in Solid's JSX, checked by `tsc` against Solid's types.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@forgebook/typescript-config/solid.json",
  "compilerOptions": {
    "types": ["node", "vite/client", "@forgebook/story-format/client"]
  },
  "include": ["src", "stories.ts", "forgebook.preview.tsx", "forgebook.config.ts", "vitest.config.ts"]
}
