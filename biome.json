{
  "root": true,
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineEnding": "lf",
    "lineWidth": 110
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "jsxQuoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "none",
      "arrowParentheses": "always",
      "bracketSpacing": true
    }
  },
  "json": {
    "parser": {
      "allowComments": true
    },
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "css": {
    "formatter": {
      "enabled": false
    },
    "linter": {
      "enabled": false
    }
  },
  "html": {
    "formatter": {
      "enabled": false
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [":NODE:", ":BLANK_LINE:", ":PACKAGE:", ":BLANK_LINE:", ":PATH:"]
          }
        }
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noForEach": "off",
        "useLiteralKeys": "off",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": {
            "maxAllowedComplexity": 15
          }
        }
      },
      "correctness": {
        "noUnusedVariables": "error",
        "noUnusedImports": "error",
        "useExhaustiveDependencies": "error"
      },
      "style": {
        "useConst": "error",
        "useImportType": "error",
        "useExportType": "error",
        "noNonNullAssertion": "error",
        "useTemplate": "error",
        "noUnusedTemplateLiteral": "error",
        "noNestedTernary": "error",
        "noUselessElse": "error",
        "useCollapsedElseIf": "error",
        "noParameterAssign": "error",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useNodejsImportProtocol": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noTsIgnore": "error",
        "noImplicitAnyLet": "error",
        "noArrayIndexKey": "error"
      },
      "performance": {
        "noBarrelFile": "error",
        "noReExportAll": "error"
      },
      "security": {
        "noSecrets": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["packages/**/*.ts", "packages/**/*.tsx"],
      "linter": {
        "rules": {
          "nursery": {
            "useExplicitType": "error"
          }
        }
      }
    },
    {
      "includes": ["**/*.ts", "**/*.tsx"],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "error",
            "noProcessEnv": "error",
            "useNamingConvention": {
              "level": "error",
              "options": {
                "strictCase": false,
                "requireAscii": true,
                "conventions": [
                  {
                    "selector": {
                      "kind": "objectLiteralProperty"
                    },
                    "formats": ["camelCase", "snake_case", "PascalCase", "CONSTANT_CASE"]
                  },
                  {
                    "selector": {
                      "kind": "typeProperty"
                    },
                    "formats": ["camelCase", "snake_case"]
                  }
                ]
              }
            },
            "useFilenamingConvention": {
              "level": "error",
              "options": {
                "filenameCases": ["camelCase", "PascalCase"],
                "requireAscii": true
              }
            },
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "./**/*.js",
                      "./**/*.mjs",
                      "./**/*.ts",
                      "./**/*.tsx",
                      "../**/*.js",
                      "../**/*.mjs",
                      "../**/*.ts",
                      "../**/*.tsx"
                    ],
                    "message": "Import without the file extension: the bundler (Vite, Playwright, the server's build) finds the file."
                  }
                ]
              }
            }
          },
          "suspicious": {
            "noConsole": "error"
          },
          "nursery": {
            "noFloatingPromises": "error"
          }
        }
      }
    },
    {
      "includes": ["packages/**", "tools/**", "fixtures/app/src/vite.config.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          },
          "correctness": {
            "useImportExtensions": "error"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.stories.tsx",
        "**/*.stories.ts",
        "**/forgebook.preview.ts",
        "**/forgebook.preview.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.svelte"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off"
          },
          "style": {
            "useConst": "off"
          }
        }
      }
    },
    {
      "includes": ["**/*.vue"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
            "useHookAtTopLevel": "off"
          },
          "style": {
            "useVueMultiWordComponentNames": "off"
          }
        }
      }
    },
    {
      "includes": [
        "**/*.config.ts",
        "**/*.config.mts",
        "**/*.config.js",
        "**/.storybook/main.ts",
        "**/.storybook/preview.tsx"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off"
          }
        }
      }
    },
    {
      "includes": [
        "packages/nextjs/src/next/**",
        "fixtures/nextjs/app/**/page.tsx",
        "fixtures/nextjs/app/**/layout.tsx",
        "**/forgebook.preview.tsx",
        "fixtures/nextjs/types.d.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noDefaultExport": "off",
            "useNamingConvention": "off"
          }
        }
      }
    },
    {
      "includes": ["fixtures/nextjs/components/**"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/testing/src/playwrightConfig.ts", "fixtures/app/shell/ports.ts"],
      "linter": {
        "rules": {
          "style": {
            "noProcessEnv": "off"
          }
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "develop"
  },
  "files": {
    "includes": [
      "**",
      "!fixtures/*/public/mockServiceWorker.js",
      "!**/*.md",
      "!**/*.html",
      "!**/*.css",
      "!**/*.scss",
      "!**/*.svg",
      "!pnpm-lock.yaml"
    ]
  }
}
