{
  "name": "@forgebook/tools",
  "version": "0.0.0",
  "private": true,
  "description": "The repository's own commands: the build of each package for npm, the check of its published manifest, the checks of the repository's text, and the benchmark; and the helpers the packages' tests share.",
  "type": "module",
  "bin": {
    "package-build": "./package-build/package-build.mts"
  },
  "exports": {
    "./bundled-code": "./bundled-code/bundledCode.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p ."
  },
  "dependencies": {
    "@ensiria/cli-kit": "^0.1.1",
    "sass-embedded": "1.106.1",
    "yaml": "2.9.0"
  },
  "peerDependencies": {
    "vite": "^8.3.4"
  },
  "devDependencies": {
    "@forgebook/typescript-config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
