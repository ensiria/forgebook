// The repository's commands: Node runs them directly with their types stripped, so relative imports carry `.ts`.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@forgebook/typescript-config/node.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true
  },
  "include": ["."],
  // each corpus's files, and each evaluation task's probe stories, are copied into a cloned app or library, the only
  // place their imports resolve
  "exclude": ["bench/corpora", "eval/tasks"]
}
