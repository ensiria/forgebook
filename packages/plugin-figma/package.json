{
  "name": "@forgebook/plugin-figma",
  "version": "0.2.7",
  "description": "Figma for Forgebook: a story's design in the panel, embedded from Figma and beside the story, and a design in a docs page.",
  "keywords": [
    "forgebook",
    "forgebook-plugin"
  ],
  "license": "MIT",
  "author": "Jason Scoppetta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensiria/forgebook.git",
    "directory": "packages/plugin-figma"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/plugin.ts",
    "./tab": "./src/DesignTab.tsx",
    "./block": "./src/DesignBlock.tsx"
  },
  "scripts": {
    "build": "package-build build",
    "manifest": "package-build manifest",
    "prepack": "package-build prepack",
    "test": "vitest run",
    "typecheck": "tsc -p src && tsc -p test"
  },
  "dependencies": {
    "@forgebook/story-format": "workspace:*"
  },
  "peerDependencies": {
    "forgebook": "workspace:^",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@forgebook/tools": "workspace:*",
    "@forgebook/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "forgebook": "workspace:*",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/plugin.d.ts",
        "default": "./dist/src/plugin.js"
      },
      "./tab": {
        "types": "./dist/src/DesignTab.d.ts",
        "default": "./dist/src/DesignTab.js"
      },
      "./block": {
        "types": "./dist/src/DesignBlock.d.ts",
        "default": "./dist/src/DesignBlock.js"
      }
    }
  }
}
