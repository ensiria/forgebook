// The Angular package's tests, run by Vitest in a simulated page (happy-dom), their components compiled by Analog's
// plugin with `tsconfig.spec.json`.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@forgebook/typescript-config/react.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    // the Vite plugin carries the `.ts` extension in its own imports (Node loads it directly)
    "allowImportingTsExtensions": true
  },
  "include": [".", "../src"]
}
