#!/usr/bin/env node
/**
 * The `forgebook-texts` command: checks a package's story texts against the keys its stories use, and lists what each
 * language still has to translate.
 *
 * @remarks
 * Usage: `forgebook-texts --help` (generated by `@ensiria/cli-kit`). A package with stories runs it on itself
 * (`"texts": "forgebook-texts --package ."`), with `--check` in CI.
 *
 * @module
 */
import { globSync, readFileSync } from "node:fs";
import { basename, join, relative, resolve } from "node:path";

import { plural } from "@ensiria/cli-kit/format";
import { defineScript, ScriptError } from "@ensiria/cli-kit/script";

import { storyTextsReport } from "./storyTextsReport.ts";
import type { StoryTextsReport } from "./storyTextsReport.types.ts";

/** The command, as the hints print it. */
const COMMAND = "forgebook-texts";

/** Where a package's story files and fixtures are, relative to it. */
const SOURCE_PATTERNS = ["src/**/*.stories.tsx", "stories/**/*.{ts,tsx}"];

/** A locale file's table, read as JSON. */
const readTable = (file: string): Readonly<Record<string, string>> => {
  const value: unknown = JSON.parse(readFileSync(file, "utf8"));
  if (typeof value !== "object" || value === null || Array.isArray(value)) {
    throw new ScriptError(`${file} is not an object of texts`);
  }
  const entries = Object.entries(value);
  const bad = entries.find(([, text]) => typeof text !== "string");
  if (bad !== undefined) throw new ScriptError(`${file}: "${bad[0]}" is not a text`);
  return Object.fromEntries(entries.map(([key, text]) => [key, String(text)]));
};

await defineScript({
  name: "forgebook-texts",
  command: COMMAND,
  summary: "Check a package's story texts and list what each language still has to translate.",
  icon: "check",
  json: true,
  description:
    'Reads the keys the stories use (every text("key") in its story files and story fixtures) and the locale files (stories/locales/<id>.json by default, en holding every key), and reports keys missing in English, English keys no story uses, and, for each other language, the texts it lacks with their English, ready to translate.',
  options: {
    package: {
      type: "string",
      required: true,
      valueName: "folder",
      description: "The package's folder (packages/design-system)."
    },
    locales: {
      type: "string",
      default: "stories/locales",
      valueName: "folder",
      description: "The locale files' folder, relative to the package."
    },
    check: {
      type: "boolean",
      short: "c",
      description:
        "Fail when a key is missing in English or an English key is unused (CI); untranslated texts do not fail."
    }
  },
  examples: [
    { command: `${COMMAND} --package .`, description: "Report the package's story texts." },
    {
      command: `${COMMAND} --package . --json`,
      description: "The texts each language lacks, for a translator."
    },
    { command: `${COMMAND} --package . --check`, description: "Check them in CI." }
  ],
  run: ({ options, log }): StoryTextsReport => {
    const packageDir = resolve(options.package);
    const localesDir = join(packageDir, options.locales);
    const sources = SOURCE_PATTERNS.flatMap((pattern) => globSync(pattern, { cwd: packageDir })).map((file) =>
      readFileSync(join(packageDir, file), "utf8")
    );
    const locales = Object.fromEntries(
      globSync("*.json", { cwd: localesDir }).map((file) => [
        basename(file, ".json"),
        readTable(join(localesDir, file))
      ])
    );
    if (locales["en"] === undefined && sources.length > 0) {
      log.warn(
        `${relative(process.cwd(), localesDir)}/en.json does not exist: no story text is translatable yet`
      );
    }
    const report = storyTextsReport(sources, locales);
    for (const key of report.missing) log.error(`missing in en.json: ${key}`);
    for (const key of report.unused) log.warn(`unused in en.json: ${key}`);
    for (const [language, texts] of Object.entries(report.untranslated)) {
      if (texts.length > 0) log.info(`${language}: ${plural(texts.length, "text")} to translate`);
    }
    if (options.check && (report.missing.length > 0 || report.unused.length > 0)) {
      throw new ScriptError(
        `${plural(report.missing.length, "missing key")}, ${plural(report.unused.length, "unused key")}`,
        { hint: `Fix ${relative(process.cwd(), join(localesDir, "en.json"))} or the stories` }
      );
    }
    log.success(`${plural(report.used, "key")} used, every one in en.json`);
    return report;
  }
}).run();
