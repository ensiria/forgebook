#!/usr/bin/env node
/**
 * The `forgebook-docs` command: writes a package's `CATALOG.md` from its exports, their TSDoc and its stories, or
 * checks that it is up to date.
 *
 * @remarks
 * Usage: `forgebook-docs --help` (generated by `@ensiria/cli-kit`). A package with stories declares
 * `forgebook` as a development dependency and runs it on itself (`"catalog": "forgebook-docs --package ."`;
 * D-62, D-67).
 *
 * @module
 */
import { createRequire } from "node:module";
import { join, relative, resolve } from "node:path";
import { pathToFileURL } from "node:url";

import { readFileSafe, writeIfChanged } from "@ensiria/cli-kit/files";
import { plural } from "@ensiria/cli-kit/format";
import { defineScript, ScriptError } from "@ensiria/cli-kit/script";

import { type ExtractStoryComponent, isDocsModule } from "../../src/vite/adapter.ts";
import type { CatalogueDocsReport } from "./catalogueDocs.types.ts";
import { catalogueMarkdown } from "./catalogueMarkdown.ts";
import { collectDocs } from "./collectDocs.ts";

/** The command, as the hints print it. */
const COMMAND = "forgebook-docs";

/**
 * The framework's reading of a story file's component: the docs module of `@forgebook/<framework>`, resolved from the
 * package, which declares that framework package.
 *
 * @param packageDir - the package's folder.
 * @param framework - the framework's name (`react`).
 * @throws a `ScriptError` when the package cannot resolve it or the module is not a docs module.
 */
const extractorOf = async (packageDir: string, framework: string): Promise<ExtractStoryComponent> => {
  const specifier = `@forgebook/${framework}/docs`;
  let file: string;
  try {
    file = createRequire(join(packageDir, "package.json")).resolve(specifier);
  } catch {
    throw new ScriptError(`${specifier} is not installed in this package`, {
      hint: `Add @forgebook/${framework} to its devDependencies`
    });
  }
  const module: unknown = await import(pathToFileURL(file).href);
  if (!isDocsModule(module)) throw new ScriptError(`${specifier} exports no extractStoryComponent`);
  return module.extractStoryComponent;
};

await defineScript({
  name: "forgebook-docs",
  command: COMMAND,
  summary: "Write a package's CATALOG.md from its exports, their TSDoc and its stories.",
  icon: "docs",
  json: true,
  description:
    "Reads the package's exports (components from its stories, modules with TypeScript 6, Sass modules and style sheets from their text) and writes CATALOG.md in its folder: one dense line per entry, for agents to read before writing a component, hook or helper.",
  options: {
    package: {
      type: "string",
      required: true,
      valueName: "folder",
      description: "The package's folder (packages/design-system)."
    },
    framework: {
      type: "string",
      default: "react",
      valueName: "name",
      description:
        "The framework the stories are written for: its package, @forgebook/<name>, reads the components' props."
    },
    check: {
      type: "boolean",
      short: "c",
      description: "Change nothing; fail when CATALOG.md is stale or a file cannot be read (CI)."
    }
  },
  examples: [
    { command: `${COMMAND} --package .`, description: "Rewrite the CATALOG.md of the package you are in." },
    { command: `${COMMAND} --package . --check`, description: "Check it in CI." }
  ],
  run: async ({ options, log }): Promise<CatalogueDocsReport> => {
    const packageDir = resolve(options.package);
    const file = join(packageDir, "CATALOG.md");
    const shownFile = relative(process.cwd(), file);
    const { data, problems } = collectDocs(packageDir, await extractorOf(packageDir, options.framework));
    for (const problem of problems) log.error(problem);
    const text = catalogueMarkdown(data);
    const counts = {
      components: data.components.length,
      modules: data.modules.length,
      sassModules: data.sassModules.length,
      styleSheets: data.styleSheets.length
    };
    if (options.check) {
      if (problems.length > 0) throw new ScriptError(`${plural(problems.length, "file")} could not be read`);
      if (readFileSafe(file) !== text)
        throw new ScriptError(`${shownFile} is stale`, {
          hint: `Run ${COMMAND} --package ${relative(process.cwd(), packageDir)}`
        });
      log.success(`${shownFile} is up to date`);
      return { status: "valid", file: shownFile, counts, problems };
    }
    const isWritten = writeIfChanged(file, text);
    log.success(`${shownFile} ${isWritten ? "written" : "already up to date"}`);
    return { status: isWritten ? "written" : "up-to-date", file: shownFile, counts, problems };
  }
}).run();
