#!/usr/bin/env node
/**
 * The `forgebook-heights` command: opens every story of a catalogue in a browser and measures how tall its frame is
 * at a few widths, for the shell to give a story's box that height while it loads.
 *
 * @remarks
 * Usage: `forgebook-heights --help` (generated by `@ensiria/cli-kit`). It measures a running catalogue, or serves a
 * built one with `--serve`, which loads far faster; the file it writes is generated, never committed.
 *
 * @module
 */
import { resolve } from "node:path";

import { writeJson } from "@ensiria/cli-kit/files";
import { plural } from "@ensiria/cli-kit/format";
import { progress } from "@ensiria/cli-kit/progress";
import { defineScript, ScriptError, usageError } from "@ensiria/cli-kit/script";

import { HEIGHT_WIDTHS } from "../../src/storyHeights.ts";
import { heightsDocument, measureStories, openCatalogue, parseWidths } from "./measureHeights.ts";
import type { HeightsReport } from "./measureHeights.types.ts";

/** The command, as the hints print it. */
const COMMAND = "forgebook-heights";

await defineScript({
  name: "forgebook-heights",
  command: COMMAND,
  summary: "Measure every story's height at a few widths, for the catalogue's loading boxes.",
  icon: "check",
  json: true,
  description:
    "Opens every story's frame (the address the catalogue's stage opens) in Chromium, waits until it is ready, and reads its height at each width, the way the frame reports it to the shell. Writes the heights as JSON for the catalogue's `heights` setting, which gives a story's box that height while it loads. The stories are measured in the default view; a story that fails or never answers is left out and reported.",
  options: {
    catalogue: {
      type: "string",
      default: "http://localhost:5310/",
      valueName: "url",
      env: "CATALOGUE_URL",
      description: "The running catalogue's address, when --serve is not given."
    },
    serve: {
      type: "string",
      valueName: "dir",
      description: "A built catalogue to serve for the run (its build folder): much faster than a dev server."
    },
    out: {
      type: "string",
      required: true,
      valueName: "file",
      description: "Where to write the heights (a .json)."
    },
    widths: {
      type: "string",
      default: HEIGHT_WIDTHS.join(","),
      valueName: "px,px",
      description: "The widths to measure at, separated by commas."
    },
    concurrency: {
      type: "string",
      default: "6",
      valueName: "count",
      description: "How many stories load at once."
    },
    timeout: {
      type: "string",
      default: "30000",
      valueName: "ms",
      description: "How long to wait for one story."
    }
  },
  examples: [
    {
      command: `${COMMAND} --serve dist --out dist/story-heights.json`,
      description: "Measure a built catalogue and write the heights beside it."
    },
    {
      command: `${COMMAND} --out public/story-heights.json`,
      description: "Measure the running development catalogue."
    }
  ],
  run: async (context): Promise<HeightsReport> => {
    const { options, log } = context;
    const widths = parseWidths(options.widths);
    if (typeof widths === "string") throw usageError(widths);
    const concurrency = Number(options.concurrency);
    const timeout = Number(options.timeout);
    if (!Number.isInteger(concurrency) || concurrency < 1)
      throw usageError("--concurrency needs a whole number");
    if (!Number.isInteger(timeout) || timeout < 1) throw usageError("--timeout needs a whole number of ms");
    const out = resolve(options.out);
    const catalogue = await openCatalogue(
      options.catalogue,
      options.serve === undefined ? undefined : resolve(options.serve)
    );
    try {
      let bar: ReturnType<typeof progress> | undefined;
      const result = await measureStories({
        address: catalogue.address,
        widths,
        concurrency,
        timeout,
        onStart: (stories: number): void => {
          bar = progress({ label: "Measuring the stories", total: stories, unit: "stories" }, context);
        },
        onStory: (): void => bar?.tick()
      }).catch((error: unknown) => {
        bar?.fail();
        throw new ScriptError(error instanceof Error ? error.message : String(error), {
          hint: `Is the catalogue running at ${catalogue.address}? Or build it and pass --serve`
        });
      });
      bar?.done(`${plural(result.measured.size, "story", "stories")} measured`);
      writeJson(out, heightsDocument(widths, result.measured));
      for (const failure of result.failures) log.warn(`${failure.story}: ${failure.reason}`);
      log.success(`heights written to ${out}`);
      return {
        out,
        widths,
        stories: result.storyIds.length,
        measured: result.measured.size,
        failures: result.failures
      };
    } finally {
      await catalogue.close();
    }
  }
}).run();
