// The Vite plugin: Node loads it directly with the app's Vite config, its types stripped, so relative imports carry
// the `.ts` extension.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@forgebook/typescript-config/node.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true
  },
  "include": ["."]
}
