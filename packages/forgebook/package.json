{
  "name": "forgebook",
  "version": "0.1.5",
  "description": "See every component in every theme, contrast, language and width: CSF stories, one frame per story, and a props table from the components' types.",
  "keywords": [
    "react",
    "catalogue",
    "stories",
    "csf",
    "design-system"
  ],
  "license": "MIT",
  "author": "Jason Scoppetta",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensiria/forgebook.git",
    "directory": "packages/forgebook"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "bin": {
    "forgebook": "./bin/forgebook/forgebook.mts",
    "forgebook-docs": "./bin/forgebook-docs/forgebook-docs.mts",
    "forgebook-texts": "./bin/forgebook-texts/forgebook-texts.mts"
  },
  "exports": {
    ".": "./src/vite/config.ts",
    "./agent": "./src/vite/agent.types.ts",
    "./story-tree": "./src/storyTree.ts",
    "./shell": "./src/shell/mountShell.tsx",
    "./frame": "./src/frame/mountFrame.ts",
    "./vite": "./src/vite/forgebookPlugin.ts",
    "./renderer": "./src/frame/renderer.ts",
    "./story-hooks": "./src/frame/storyHooks.ts",
    "./story-module": "./src/frame/storyModule.ts",
    "./messages": "./src/messages.ts",
    "./component-docs": "./src/componentDocs.ts",
    "./vite/adapter": "./src/vite/adapter.ts",
    "./vite/docs-program": "./src/vite/docsProgram.ts",
    "./vite/story-meta": "./src/vite/storyMeta.ts",
    "./catalogue-docs": "./bin/forgebook-docs/collectDocs.ts",
    "./catalogue-markdown": "./bin/forgebook-docs/catalogueMarkdown.ts",
    "./catalogue-options": "./bin/forgebook-docs/catalogueOptions.ts",
    "./a11y": "./src/a11y.ts",
    "./frame-status": "./src/frame/frameStatus.ts",
    "./story-heights": "./src/storyHeights.ts",
    "./story-ids-element": "./src/storyIdsElement.ts",
    "./view-state": "./src/viewState.ts",
    "./frame-clock": "./src/frame/frameClock.ts",
    "./source-files": "./src/sourceFiles.ts",
    "./story-clock": "./src/storyClock.ts",
    "./story-texts": "./src/storyTexts.ts",
    "./vite/auto-title": "./src/vite/autoTitle.ts",
    "./vite/index-story-file": "./src/vite/indexStoryFile.ts",
    "./vite/story-files-module": "./src/vite/storyFilesModule.ts",
    "./switches": "./src/switches.ts",
    "./catalogue": "./src/catalogue.ts",
    "./story-check": "./src/storyCheck.ts",
    "./spills": "./src/spills.ts",
    "./real-touch": "./src/realTouch.ts"
  },
  "scripts": {
    "build": "package-build build",
    "manifest": "package-build manifest",
    "prepack": "package-build prepack",
    "test": "vitest run",
    "typecheck": "tsc -p src && tsc -p src/vite && tsc -p bin && tsc -p test"
  },
  "dependencies": {
    "@ensiria/cli-kit": "^0.1.1",
    "@forgebook/story-format": "workspace:*",
    "axe-core": "4.14.0",
    "highlight.js": "11.12.0",
    "lightningcss": "1.33.0",
    "marked": "18.1.0",
    "typescript-6": "npm:typescript@6.0.3"
  },
  "peerDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/user-event": "^14.6.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sass-embedded": "^1.80.0",
    "vite": "^8.0.0"
  },
  "devDependencies": {
    "@forgebook/tools": "workspace:*",
