{
  "color": {
    "$type": "color",
    "brand": {
      "primary": {
        "$value": "#e8501c",
        "$description": "The accent."
      },
      "ink": {
        "$value": {
          "colorSpace": "srgb",
          "components": [0.11, 0.098, 0.082],
          "hex": "#1c1915"
        }
      },
      "wide": {
        "$value": {
          "colorSpace": "display-p3",
          "components": [1, 0.2, 0.1]
        }
      },
      "old": {
        "$value": "#ff0000",
        "$deprecated": "Use color.brand.primary."
      }
    },
    "action": {
      "$value": "{color.brand.primary}"
    }
  },
  "space": {
    "$type": "dimension",
    "small": {
      "$value": {
        "value": 8,
        "unit": "px"
      }
    },
    "large": {
      "$value": {
        "value": 1.5,
        "unit": "rem"
      }
    }
  },
  "motion": {
    "quick": {
      "$type": "duration",
      "$value": {
        "value": 120,
        "unit": "ms"
      }
    }
  },
  "font": {
    "body": {
      "$type": "fontFamily",
      "$value": ["Inter", "sans-serif"]
    }
  },
  "shadow": {
    "raised": {
      "$type": "shadow",
      "$value": {
        "color": "{color.brand.ink}",
        "offsetX": {
          "value": 0,
          "unit": "px"
        },
        "offsetY": {
          "value": 2,
          "unit": "px"
        },
        "blur": {
          "value": 4,
          "unit": "px"
        }
      }
    }
  }
}
