// The catalogue's tests, run by Vitest on Node.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@radar/typescript-config/react.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    // the plugin's modules carry the `.ts` extension in their own imports (Node loads them directly)
    "allowImportingTsExtensions": true
  },
  "include": [".", "../src"]
}
