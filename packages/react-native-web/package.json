{
  "name": "@forgebook/react-native-web",
  "version": "0.2.7",
  "description": "Forgebook for React Native: a React Native project's components drawn in the browser through react-native-web, on Vite, their props read as React's.",
  "keywords": [
    "react-native",
    "react-native-web",
    "expo",
    "react",
    "catalogue",
    "stories"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensiria/forgebook.git",
    "directory": "packages/react-native-web"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/stories.ts",
    "./docs": "./src/vite/extractDocs.ts",
    "./frame": "./src/mountFrame.ts",
    "./frame-renderer": "./src/nativeFrameRenderer.ts",
    "./renderer": "./src/nativeRenderer.ts",
    "./vite": "./src/vite/reactNativeWeb.ts"
  },
  "scripts": {
    "build": "package-build build",
    "manifest": "package-build manifest",
    "prepack": "package-build prepack",
    "test": "vitest run",
    "typecheck": "tsc -p src && tsc -p src/vite && tsc -p test"
  },
  "dependencies": {
    "@forgebook/react": "workspace:*",
    "@vitejs/plugin-react": "6.1.2",
    "flow-remove-types": "2.338.0",
    "postcss-load-config": "6.0.1",
    "vite": "^8.3.4"
  },
  "peerDependencies": {
    "@babel/core": "^7.29.0",
    "@rolldown/plugin-babel": "^0.2.4",
    "forgebook": "workspace:^",
    "postcss": "^8.4.0",
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "react-native": ">=0.76.0 <1.0.0",
    "react-native-web": "^0.21.0"
  },
  "peerDependenciesMeta": {
    "@babel/core": {
      "optional": true
    },
    "@rolldown/plugin-babel": {
      "optional": true
    },
    "postcss": {
      "optional": true
    }
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@forgebook/story-format": "workspace:*",
    "@forgebook/testing": "workspace:*",
    "@forgebook/tools": "workspace:*",
    "@forgebook/typescript-config": "workspace:*",
    "@rolldown/plugin-babel": "0.2.4",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "forgebook": "workspace:*",
    "happy-dom": "21.0.4",
    "postcss": "8.5.32",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-web": "0.21.4",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/stories.d.ts",
        "default": "./dist/src/stories.js"
      },
      "./docs": {
        "types": "./dist/src/vite/extractDocs.d.ts",
        "default": "./dist/src/vite/extractDocs.js"
      },
      "./frame": {
        "types": "./dist/src/mountFrame.d.ts",
        "default": "./dist/src/mountFrame.js"
      },
      "./frame-renderer": {
        "types": "./dist/src/nativeFrameRenderer.d.ts",
        "default": "./dist/src/nativeFrameRenderer.js"
      },
      "./renderer": {
        "types": "./dist/src/nativeRenderer.d.ts",
        "default": "./dist/src/nativeRenderer.js"
      },
      "./vite": {
        "types": "./dist/src/vite/reactNativeWeb.d.ts",
        "default": "./dist/src/vite/reactNativeWeb.js"
      }
    }
  }
}
