// The React Native package's tests, run by Vitest: the renderer in a simulated page (happy-dom), the plugins on Node.
// `project/` is the small React Native project the build test compiles, written as Metro reads it, not checked here.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@forgebook/typescript-config/react.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": [".", "../src"],
  "exclude": ["project"]
}
