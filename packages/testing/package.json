{
  "name": "@forgebook/testing",
  "version": "0.2.1",
  "description": "Tests from a package's stories: each story and variant in the browser with axe, spills and overlays, screenshots, and each story rendered on the server.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensiria/forgebook.git",
    "directory": "packages/testing"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": [
    "*.css"
  ],
  "bin": {
    "forgebook-heights": "./bin/forgebook-heights/forgebook-heights.mts",
    "forgebook-shot": "./bin/forgebook-shot/forgebook-shot.mts"
  },
  "exports": {
    "./browser": "./src/browserTests.ts",
    "./server": "./src/serverTests.ts",
    "./story-files": "./src/storyFiles.ts",
    "./playwright": "./src/playwrightConfig.ts",
    "./vite": "./src/testViteConfig.ts",
    "./visual-browser": "./src/visualBrowser.ts",
    "./overlays": "./src/overlays.ts",
    "./check": "./src/checkStories.ts",
    "./check-page": "./src/checkPage.ts",
    "./conformance": "./src/conformance.ts",
    "./diff": "./src/diffStories.ts",
    "./shot": "./src/shotStories.ts",
    "./touch": "./src/touchWindow.ts",
    "./fonts.css": "./src/fonts/fonts.css"
  },
  "scripts": {
    "build": "package-build build",
    "manifest": "package-build manifest",
    "prepack": "package-build prepack",
    "test": "vitest run",
    "typecheck": "tsc -p src && tsc -p bin && tsc -p test"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@ensiria/cli-kit": "^0.1.1",
    "@forgebook/story-format": "workspace:*"
  },
  "peerDependencies": {
    "@playwright/test": "^1.64.0",
    "forgebook": "workspace:^",
    "vite": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "devDependencies": {
    "@forgebook/tools": "workspace:*",
    "@forgebook/typescript-config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "forgebook": "workspace:*",
    "react": "19.3.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      "./browser": {
        "types": "./dist/src/browserTests.d.ts",
        "default": "./dist/src/browserTests.js"
      },
      "./server": {
        "types": "./dist/src/serverTests.d.ts",
        "default": "./dist/src/serverTests.js"
      },
      "./story-files": {
        "types": "./dist/src/storyFiles.d.ts",
        "default": "./dist/src/storyFiles.js"
      },
      "./playwright": {
        "types": "./dist/src/playwrightConfig.d.ts",
        "default": "./dist/src/playwrightConfig.js"
      },
      "./vite": {
        "types": "./dist/src/testViteConfig.d.ts",
        "default": "./dist/src/testViteConfig.js"
      },
      "./visual-browser": {
        "types": "./dist/src/visualBrowser.d.ts",
        "default": "./dist/src/visualBrowser.js"
      },
      "./overlays": {
        "types": "./dist/src/overlays.d.ts",
        "default": "./dist/src/overlays.js"
      },
      "./check": {
        "types": "./dist/src/checkStories.d.ts",
        "default": "./dist/src/checkStories.js"
      },
      "./check-page": {
        "types": "./dist/src/checkPage.d.ts",
        "default": "./dist/src/checkPage.js"
      },
      "./conformance": {
        "types": "./dist/src/conformance.d.ts",
        "default": "./dist/src/conformance.js"
      },
      "./diff": {
        "types": "./dist/src/diffStories.d.ts",
        "default": "./dist/src/diffStories.js"
      },
      "./shot": {
        "types": "./dist/src/shotStories.d.ts",
        "default": "./dist/src/shotStories.js"
      },
      "./touch": {
        "types": "./dist/src/touchWindow.d.ts",
        "default": "./dist/src/touchWindow.js"
      },
      "./fonts.css": "./dist/src/fonts/fonts.css"
    },
    "bin": {
      "forgebook-heights": "./dist/bin/forgebook-heights/forgebook-heights.mjs",
      "forgebook-shot": "./dist/bin/forgebook-shot/forgebook-shot.mjs"
    }
  }
}
