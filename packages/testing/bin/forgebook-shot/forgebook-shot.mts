#!/usr/bin/env node
/**
 * The `forgebook-shot` command: opens one story of a running catalogue in a browser, waits for it, and reports how it
 * ended, its size, a picture and, when asked, the accessibility rules it breaks: what an agent needs to check a story
 * it wrote without a person looking.
 *
 * @remarks
 * Usage: `forgebook-shot --help` (generated by `@ensiria/cli-kit`). The catalogue must be running
 * (`pnpm --filter @radar/catalogue dev`).
 *
 * @module
 */
import { resolve } from "node:path";

import { defineScript, ScriptError, usageError } from "@ensiria/cli-kit/script";

import { takeShot } from "./storyShot.ts";
import type { StoryShot } from "./storyShot.types.ts";

/** The command, as the hints print it. */
const COMMAND = "forgebook-shot";

await defineScript({
  name: "forgebook-shot",
  command: COMMAND,
  summary: "Open one story of a running catalogue, wait for it, and report it with a picture.",
  icon: "check",
  json: true,
  description:
    "Opens the story's frame (the address the catalogue's stage and the generated tests open) in Chromium with the given view, waits until it says ready or failed, and reports its size, the page's console errors, a full-page PNG when --out is given, and the axe violations of WCAG 2.2 A and AA with --a11y. A story that fails or never answers ends the command with an error.",
  options: {
    catalogue: {
      type: "string",
      default: "http://localhost:5310/",
      valueName: "url",
      env: "CATALOGUE_URL",
      description: "The running catalogue's address."
    },
    story: {
      type: "string",
      required: true,
      valueName: "id",
      description:
        "The story's id, as the catalogue's address writes it (kaji-ui:feedback-markers-counter--plain)."
    },
    view: {
      type: "string",
      default: "",
      valueName: "query",
      description: "The view, as the catalogue's address writes it (theme=dark&contrast=more&lang=it)."
    },
    width: {
      type: "string",
      default: "1024",
      valueName: "px",
      description: "The width the story is drawn at."
    },
    out: { type: "string", valueName: "file", description: "Where to write the picture (a .png)." },
    a11y: { type: "boolean", description: "Also check the story's accessibility (axe, WCAG 2.2 A and AA)." },
    timeout: {
      type: "string",
      default: "30000",
      valueName: "ms",
      description: "How long to wait for the story."
    }
  },
  examples: [
    {
      command: `${COMMAND} --story kaji-ui:feedback-markers-counter--plain --out counter.png`,
      description: "A picture of a story, in the default view."
    },
    {
      command: `${COMMAND} --story kaji-ui:feedback-markers-counter--plain --view theme=dark --a11y --json`,
      description: "The dark theme, with its accessibility, as JSON."
    }
  ],
  run: async ({ options, log }): Promise<StoryShot> => {
    const width = Number(options.width);
    const timeout = Number(options.timeout);
    if (!Number.isInteger(width) || width < 1) throw usageError("--width needs a whole number of px");
    if (!Number.isInteger(timeout) || timeout < 1) throw usageError("--timeout needs a whole number of ms");
    const shot = await takeShot({
      catalogue: options.catalogue,
      story: options.story,
      view: options.view,
      width,
      out: options.out === undefined ? undefined : resolve(options.out),
      isA11y: options.a11y,
      timeout
    });
    if (shot.status === "timeout") {
      throw new ScriptError(`${shot.story} did not answer in ${timeout} ms`, {
        hint: `Is the catalogue running at ${options.catalogue}? Open ${shot.address}`
      });
    }
    for (const message of shot.consoleErrors) log.warn(message);
    if (shot.status === "error") {
      throw new ScriptError(`${shot.story} failed: ${shot.error ?? "no message"}`, {
        hint: `Open ${shot.address} to see it`
      });
    }
    log.success(`${shot.story} is shown, ${shot.size.width} × ${shot.size.height} px`);
    if (shot.screenshot !== undefined) log.info(`picture: ${shot.screenshot}`);
    if (shot.violations !== undefined) {
      if (shot.violations.length === 0) log.success("no accessibility rule broken");
      for (const violation of shot.violations) log.error(`${violation.id}: ${violation.help}`);
    }
    return shot;
  }
}).run();
