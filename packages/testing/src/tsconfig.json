// The test generators: they run inside Playwright or Vitest, which resolve imports without extensions; the plugin's
// modules they reuse carry `.ts` in their own imports (Node loads them directly), hence the flag.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@forgebook/typescript-config/react.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["."]
}
