// The Svelte package's tests, run by Vitest in a simulated page (happy-dom) and in Node; checked by `svelte-check`, which
// reads their components.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@forgebook/typescript-config/react.json",
  "compilerOptions": {
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": [".", "../src"],
  "exclude": ["fixtures"]
}
