{
  "name": "@forgebook/react",
  "version": "0.0.0",
  "private": true,
  "description": "Forgebook for React: the story types and hooks, the renderer the frame mounts a story with, and the adapter that reads a React component's props.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Ensiria/forgebook.git",
    "directory": "packages/react"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    "./renderer": "./src/reactRenderer.tsx",
    "./frame": "./src/mountFrame.ts",
    "./code": "./src/storyJsx.ts",
    "./vite": "./src/vite/react.ts",
    "./docs": "./src/vite/extractDocs.ts"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc -p src && tsc -p src/vite && tsc -p test",
    "test:shell": "playwright test -c test/shell/playwright.config.ts"
  },
  "dependencies": {
    "@forgebook/story-format": "workspace:*",
    "forgebook": "workspace:*",
    "typescript-6": "npm:typescript@6.0.3"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0"
  },
  "devDependencies": {
    "@fixture/kit": "workspace:*",
    "@forgebook/testing": "workspace:*",
    "@forgebook/typescript-config": "workspace:*",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sass-embedded": "1.106.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
