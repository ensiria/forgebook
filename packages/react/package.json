{
  "name": "@forgebook/react",
  "version": "0.1.8",
  "description": "Forgebook for React: the story types and hooks, the renderer the frame mounts a story with, and the adapter that reads a React component's props.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ensiria/forgebook.git",
    "directory": "packages/react"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "sideEffects": false,
  "exports": {
    ".": "./src/stories.ts",
    "./clock": "./src/clock.ts",
    "./storybook-hooks": "./src/storybookHooks.ts",
    "./texts": "./src/texts.ts",
    "./renderer": "./src/reactRenderer.tsx",
    "./frame-renderer": "./src/reactFrameRenderer.tsx",
    "./frame": "./src/mountFrame.ts",
    "./code": "./src/storyJsx.ts",
    "./vite": "./src/vite/react.ts",
    "./docs": "./src/vite/extractDocs.ts"
  },
  "scripts": {
    "build": "package-build build",
    "manifest": "package-build manifest",
    "prepack": "package-build prepack",
    "test": "vitest run",
    "typecheck": "tsc -p src && tsc -p src/vite && tsc -p test"
  },
  "dependencies": {
    "@forgebook/story-format": "workspace:*",
    "@vitejs/plugin-react": "6.1.2"
  },
  "peerDependencies": {
    "react": "^18.2.0 || ^19.0.0",
    "react-dom": "^18.2.0 || ^19.0.0",
    "forgebook": "workspace:^"
  },
  "devDependencies": {
    "@forgebook/testing": "workspace:*",
    "@forgebook/tools": "workspace:*",
    "@forgebook/typescript-config": "workspace:*",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "forgebook": "workspace:*",
    "happy-dom": "21.0.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/src/stories.d.ts",
        "default": "./dist/src/stories.js"
      },
      "./clock": {
        "types": "./dist/src/clock.d.ts",
        "default": "./dist/src/clock.js"
      },
      "./storybook-hooks": {
        "types": "./dist/src/storybookHooks.d.ts",
        "default": "./dist/src/storybookHooks.js"
      },
      "./texts": {
        "types": "./dist/src/texts.d.ts",
        "default": "./dist/src/texts.js"
      },
      "./renderer": {
        "types": "./dist/src/reactRenderer.d.ts",
        "default": "./dist/src/reactRenderer.js"
      },
      "./frame-renderer": {
        "types": "./dist/src/reactFrameRenderer.d.ts",
        "default": "./dist/src/reactFrameRenderer.js"
      },
      "./frame": {
        "types": "./dist/src/mountFrame.d.ts",
        "default": "./dist/src/mountFrame.js"
      },
      "./code": {
        "types": "./dist/src/storyJsx.d.ts",
        "default": "./dist/src/storyJsx.js"
      },
      "./vite": {
        "types": "./dist/src/vite/react.d.ts",
        "default": "./dist/src/vite/react.js"
      },
      "./docs": {
        "types": "./dist/src/vite/extractDocs.d.ts",
        "default": "./dist/src/vite/extractDocs.js"
      }
    }
  }
}
