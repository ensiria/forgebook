// The Next.js adapter for the Vite plugin, its plugins and its docs module: Node loads them directly with their types
// stripped, so relative imports carry the `.ts` extension.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@forgebook/typescript-config/node.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true
  },
  "include": ["."]
}
