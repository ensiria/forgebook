// The Next.js package's sources that run in a page: the renderer, the frame page, the stand-ins of Next.js's modules.
// `vite/` runs on Node and has its own tsconfig.json.
{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "@forgebook/typescript-config/react.json",
  "compilerOptions": {
    "types": ["vite/client"]
  },
  "include": ["."],
  "exclude": ["vite"]
}
