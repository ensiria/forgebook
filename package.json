{
  "name": "forgebook-workspace",
  "private": true,
  "description": "Forgebook, its story format and its framework packages.",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome ci . && eslint .",
    "format": "biome check --write .",
    "build": "pnpm --filter \"./packages/*\" build",
    "manifest": "pnpm --filter \"./packages/*\" manifest",
    "manifest:check": "pnpm --filter \"./packages/*\" manifest --check"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@typescript-eslint/parser": "8.72.0",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "9.39.5",
    "eslint-plugin-jsdoc": "65.4.2",
    "eslint-plugin-tsdoc": "0.5.4",
    "jiti": "2.7.0",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
