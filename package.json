{
  "name": "forgebook-workspace",
  "private": true,
  "description": "Forgebook, its story format and its framework packages.",
  "type": "module",
  "packageManager": "pnpm@10.19.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "lint": "biome ci . && eslint .",
    "format": "biome check --write .",
    "build": "pnpm --filter \"./packages/*\" build",
    "manifest": "pnpm --filter \"./packages/*\" manifest",
    "manifest:check": "pnpm --filter \"./packages/*\" manifest --check",
    "bench": "node tools/bench/bench.mts",
    "refs:check": "node tools/check-internal-refs/check-internal-refs.mts",
    "blocks:check": "node tools/check-markdown-blocks/check-markdown-blocks.mts",
    "checks": "pnpm typecheck && pnpm lint && pnpm refs:check && pnpm blocks:check && pnpm test && pnpm manifest:check && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@nx/js": "24.0.6",
    "@typescript-eslint/parser": "8.72.2",
    "@typescript/native": "npm:typescript@7.0.2",
    "eslint": "10.14.0",
    "eslint-plugin-jsdoc": "65.4.5",
    "eslint-plugin-tsdoc": "0.5.4",
    "jiti": "2.7.0",
    "nx": "24.0.6",
    "typescript": "npm:@typescript/typescript6@6.0.2"
  }
}
